# Copy to .env and keep that file private. This template is for production.
# Local development can instead use the explicit DEBUG=1 instructions in SETUP.md.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=math-stoa.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://math-stoa.org
PUBLIC_BASE_URL=https://math-stoa.org

# Compose uses this password for PostgreSQL. Generate a random hex value.
POSTGRES_PASSWORD=
# Outside Compose, set the full PostgreSQL URL. Compose supplies its own URL.
DATABASE_URL=

# Enable only behind a trusted proxy which overwrites X-Forwarded-Proto.
DJANGO_SECURE_PROXY_SSL_HEADER=false

# Leave both values blank to hide a provider until it is configured.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_SANDBOX=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional server credential with read-only public-repository access for API quota.
# This does not verify a submitter's own permission.
REPOSITORY_GITHUB_READ_TOKEN=
REPOSITORY_VERIFICATION_VALID_DAYS=30
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# One configured institutional OpenID Connect provider or broker.
# Obtain its issuer/server URL and credentials from the institution or broker.
INSTITUTION_CLIENT_ID=
INSTITUTION_CLIENT_SECRET=
INSTITUTION_SERVER_URL=
INSTITUTION_NAME=University or institution
# Set if the authorization endpoint uses a different origin from discovery.
# Example: https://login.university.example (no path or trailing slash).
# INSTITUTION_AUTHORIZATION_ORIGIN=

# Enable only after configuring SMTP, or configure a provider above.
# With neither SMTP sign-in nor a provider enabled, users cannot sign in.
EMAIL_LOGIN_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

# Public support/contact mailbox displayed in the privacy notice.
PUBLIC_CONTACT_EMAIL=
